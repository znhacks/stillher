theme_override_fonts/font = ExtResource("1_font")
theme_override_font_sizes/font_size = 19
text = "Two weeks ago, the Vanguard industrial reactor ruptured over District 4, releasing high-density synthetic neuro-spores.
The contamination permanently alters pigmentation to necrosis green, causing violent psychosis and rapid decay of the human empathy cortex.

You, Jito, dragged Hana into this reinforced sub-level bunker before the automated security doors sealed for 120 hours.
Rations are limited. The air filters are choking on spores.
And every day, the woman you love slips further into the monster she is becoming.
Survive until Day 5. Or find a way through the rot."
horizontal_alignment = 1
autowrap_mode = 2

